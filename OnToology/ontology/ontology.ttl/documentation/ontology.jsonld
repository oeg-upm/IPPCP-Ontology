  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A coherent set of direct positions in space. The positions are held within a Spatial Reference System (SRS)."
  }, {
    "@language" : "es",
    "@value" : "Un conjunto coherente de posiciones directas en el espacio. Las posiciones se expresan dentro de un sistema de referencia espacial (SRS)."
  } ],
