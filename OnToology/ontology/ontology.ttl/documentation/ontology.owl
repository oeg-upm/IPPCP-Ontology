<?xml version="1.0"?>
<rdf:RDF xmlns="http://w3id.org/def/emissionsInventoryOntology#"
     xml:base="http://w3id.org/def/emissionsInventoryOntology"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:mod="https://w3id.org/mod#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/">
    <owl:Ontology rdf:about="http://w3id.org/def/emissionsInventoryOntology#">
        <owl:versionIRI rdf:resource="http://w3id.org/def/emissionsInventoryOntology/1.0.0"/>
        <dc:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-24</dc:created>
        <dc:creator xml:lang="es">Edgar Alexis Martínez</dc:creator>
        <dc:creator xml:lang="es">Lucía Sánchez-González</dc:creator>
        <dc:creator xml:lang="es">Oscar Corcho</dc:creator>
        <dc:description xml:lang="en">City-level environmental and climate ontology for Local Green Deal.</dc:description>
        <dc:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dc:title xml:lang="en">The Emissions lnventory Ontology</dc:title>
        <vann:preferredNamespacePrefix>eio</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri rdf:resource="http://w3id.org/def/emissionsInventoryOntology#"/>
        <owl:versionInfo>1.0.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/elements/1.1/contributor -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/contributor"/>
    


    <!-- http://purl.org/dc/elements/1.1/created -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/created"/>
    


    <!-- http://purl.org/dc/elements/1.1/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/creator"/>
    


    <!-- http://purl.org/dc/elements/1.1/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/description"/>
    


    <!-- http://purl.org/dc/elements/1.1/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/license"/>
    


    <!-- http://purl.org/dc/elements/1.1/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/title"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespaceUri -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>
    


    <!-- http://www.w3.org/2000/01/rdf-schema#comment -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#comment">
        <rdfs:label>comment</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://www.w3.org/2000/01/rdf-schema#label -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#label">
        <rdfs:label>label</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://www.w3.org/2002/07/owl#versionIRI -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2002/07/owl#versionIRI"/>
    


    <!-- http://www.w3.org/2002/07/owl#versionInfo -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2002/07/owl#versionInfo"/>
    


    <!-- https://w3id.org/mod#createdWith -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/mod#createdWith"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.opengis.net/ont/geosparql#wktLiteral -->


    <rdfs:Datatype rdf:about="http://www.opengis.net/ont/geosparql#wktLiteral">
        <rdfs:comment xml:lang="en">A Well-known Text serialization of a Geometry object.</rdfs:comment>
        <rdfs:comment xml:lang="es">Una serialización Well-Known Text de un objeto geométrico.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
        <rdfs:label xml:lang="en">Well-known Text literal</rdfs:label>
    </rdfs:Datatype>
    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#gYear -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#gYear"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://w3id.org/def/emissionsInventoryOntology#refersToSector -->


    <owl:ObjectProperty rdf:about="http://w3id.org/def/emissionsInventoryOntology#refersToSector">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4city/KeyPerformanceIndicatorAssessment"/>
        <rdfs:range rdf:resource="http://w3id.org/def/emissionsInventoryOntology#Sector"/>
        <rdfs:comment xml:lang="es">Esta propiedad vincula una instancia de s4city:KeyPerformanceIndicatorAssessment con una instancia de eio:Sector. Identifica el sector dentro del cual se interpreta o aplica el indicador clave de rendimiento evaluado.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property links an instance of s4city:KeyPerformanceIndicatorAssessment to an instance of eio:Sector. It identifies the sector within which the assessed key performance indicator is interpreted or applied.</rdfs:comment>
        <rdfs:label xml:lang="en">refers to sector</rdfs:label>
        <rdfs:label xml:lang="es">refiere al sector</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.opengis.net/ont/geosparql#hasGeometry -->


    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#hasGeometry">
        <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
        <rdfs:comment xml:lang="en">A spatial representation for a given Feature.</rdfs:comment>
        <rdfs:comment xml:lang="es">Una representación espacial para una característica determinada.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
        <rdfs:label xml:lang="en">has Geometry</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.opengis.net/ont/geosparql#sfContains -->


    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#sfContains">
        <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <rdfs:comment xml:lang="es">Indica que el objeto espacial que actúa como sujeto contiene espacialmente al objeto espacial que actúa como objeto.</rdfs:comment>
        <rdfs:comment xml:lang="en">States that the subject SpatialObject spatially contains the object SpatialObject.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
        <rdfs:label xml:lang="es">contiene espacialmente</rdfs:label>
        <rdfs:label xml:lang="en">sf contains</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.opengis.net/ont/geosparql#sfWithin -->


    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#sfWithin">
        <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <rdfs:comment xml:lang="es">Indica que el objeto espacial que actúa como sujeto está espacialmente contenido dentro del objeto espacial que actúa como objeto.</rdfs:comment>
        <rdfs:comment xml:lang="en">States that the subject SpatialObject is spatially within the object SpatialObject.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
        <rdfs:label xml:lang="en">sf within</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2004/02/skos/core#broader -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/2004/02/skos/core#broader">
        <rdfs:domain rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="es">Relaciona un concepto con otro concepto cuyo significado es más amplio o general.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a concept to a concept that is broader in meaning.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2004/02/skos/core"/>
        <rdfs:label xml:lang="en">broader</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2006/time#hasDateTimeDescription -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/2006/time#hasDateTimeDescription">
        <rdfs:domain rdf:resource="http://www.w3.org/2006/time#DateTimeInterval"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#GeneralDateTimeDescription"/>
        <rdfs:comment xml:lang="es">Valor de DateTimeInterval expresado como un valor estructurado. El inicio y el final del intervalo coinciden con los límites del elemento más corto de la descripción.</rdfs:comment>
        <rdfs:comment xml:lang="en">Value of DateTimeInterval expressed as a structured value. The beginning and end of the interval coincide with the limits of the shortest element in the description.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2006/time#"/>
        <rdfs:label>has date time description</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://saref.etsi.org/core/isMeasuredIn -->


    <owl:ObjectProperty rdf:about="https://saref.etsi.org/core/isMeasuredIn">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4city/KeyPerformanceIndicatorAssessment"/>
        <rdfs:range rdf:resource="https://saref.etsi.org/core/UnitOfMeasure"/>
        <rdfs:comment xml:lang="en">A relationship identifying the unit of measure used for a certain entity.</rdfs:comment>
        <rdfs:comment xml:lang="es">Una relación que identifica la unidad de medida utilizada para una determinada entidad.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://saref.etsi.org/core/"/>
        <rdfs:label xml:lang="en">is measured in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://saref.etsi.org/saref4city/quantifiesKPI -->


    <owl:ObjectProperty rdf:about="https://saref.etsi.org/saref4city/quantifiesKPI">
        <rdfs:range rdf:resource="https://saref.etsi.org/saref4city/KeyPerformanceIndicator"/>
        <rdfs:comment xml:lang="es">Relación entre una evaluación de indicadores clave de rendimiento y el indicador clave de rendimiento general que se está evaluando.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relation between a Key Performance Indicator Assessment and the general Key Performance Indicator being assessed</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://saref.etsi.org/saref4city/"/>
        <rdfs:label>quantifies KPI</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://saref.etsi.org/saref4city/refersToFeature -->


    <owl:ObjectProperty rdf:about="https://saref.etsi.org/saref4city/refersToFeature">
        <rdfs:domain rdf:resource="https://saref.etsi.org/saref4city/KeyPerformanceIndicatorAssessment"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:comment xml:lang="es">Relación entre una evaluación de KPI y la característica geográfica a la que se refiere.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relation between a KPI assessment and the geographical feature it refers to</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://saref.etsi.org/saref4city/"/>
        <rdfs:label>refers to feature</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://saref.etsi.org/saref4city/refersToTime -->


    <owl:ObjectProperty rdf:about="https://saref.etsi.org/saref4city/refersToTime">
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
        <rdfs:comment xml:lang="es">Relación entre una evaluación de KPI y la entidad temporal a la que se refiere.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relation between a KPI assessment and the temporal entity it refers to.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://saref.etsi.org/saref4city/"/>
        <rdfs:label>refers to time</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.opengis.net/ont/geosparql#asWKT -->


    <owl:DatatypeProperty rdf:about="http://www.opengis.net/ont/geosparql#asWKT">
        <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#wktLiteral"/>
        <rdfs:comment xml:lang="en">Links a Geometry to its Well-Known Text (WKT) serialization.</rdfs:comment>
        <rdfs:comment xml:lang="es">Vincula una geometría con su serialización en formato Well-Known Text (WKT).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
        <rdfs:label xml:lang="en">as WKT</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/2006/time#year -->


    <owl:DatatypeProperty rdf:about="http://www.w3.org/2006/time#year">
        <rdfs:domain rdf:resource="http://www.w3.org/2006/time#DateTimeDescription"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#gYear"/>
        <rdfs:comment xml:lang="es">Posición del año en un sistema de calendario y reloj.</rdfs:comment>
        <rdfs:comment xml:lang="en">Year position in a calendar-clock system.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2006/time#"/>
        <rdfs:label xml:lang="en">year</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://saref.etsi.org/core/hasValue -->


    <owl:DatatypeProperty rdf:about="https://saref.etsi.org/core/hasValue">
        <rdfs:comment xml:lang="es">Valor de una propiedad expresado como un literal RDF. Tenga en cuenta que, aunque se esperan valores decimales, estos podrían utilizar otros tipos de datos.</rdfs:comment>
        <rdfs:comment xml:lang="en">Value of a property value expressed as an RDF literal. Note that, even if decimal values are expected, values could use other datatypes.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://saref.etsi.org/core/"/>
        <rdfs:label>has value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://w3id.org/def/emissionsInventoryOntology#Cell -->


    <owl:Class rdf:about="http://w3id.org/def/emissionsInventoryOntology#Cell">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:comment xml:lang="en">A spatial unit that represents an individual division of a geographic grid or urban mesh. Example: A square cell of an urban grid or a hexagonal cell used for spatial analysis.</rdfs:comment>
        <rdfs:comment xml:lang="es">Unidad espacial que representa una división individual de una cuadrícula geográfica o red urbana. Ejemplo: Una celda cuadrada de una cuadrícula urbana o una celda hexagonal utilizada para análisis espacial.</rdfs:comment>
        <rdfs:label xml:lang="es">Celda</rdfs:label>
        <rdfs:label xml:lang="en">Cell</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/def/emissionsInventoryOntology#Sector -->


    <owl:Class rdf:about="http://w3id.org/def/emissionsInventoryOntology#Sector">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A broad area of economic or productive activity, such as agriculture, industry, or transport.</rdfs:comment>
        <rdfs:comment xml:lang="es">Un ámbito amplio de actividad económica o productiva, como la agricultura, la industria o el transporte.</rdfs:comment>
        <rdfs:label xml:lang="en">Sector</rdfs:label>
        <rdfs:label xml:lang="es">Sector</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opengis.net/ont/geosparql#Feature -->


    <owl:Class rdf:about="http://www.opengis.net/ont/geosparql#Feature">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <rdfs:comment xml:lang="en">A discrete spatial phenomenon in a universe of discourse. A Feature represents a uniquely identifiable phenomenon, for example a river or an apple.</rdfs:comment>
        <rdfs:comment xml:lang="es">Un fenómeno espacial discreto dentro de un universo de discurso. Una entidad geográfica representa un fenómeno identificable de manera única, como un río o una manzana.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql"/>
        <rdfs:label>Feature</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opengis.net/ont/geosparql#Geometry -->


    <owl:Class rdf:about="http://www.opengis.net/ont/geosparql#Geometry">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <rdfs:comment xml:lang="en">A coherent set of direct positions in space. The positions are held within a Spatial Reference System (SRS).</rdfs:comment>
        <rdfs:comment xml:lang="es">Un conjunto coherente de posiciones directas en el espacio. Las posiciones se expresan dentro de un sistema de referencia espacial (SRS).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
        <rdfs:label xml:lang="en">Geometry</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opengis.net/ont/geosparql#SpatialObject -->


    <owl:Class rdf:about="http://www.opengis.net/ont/geosparql#SpatialObject">
        <rdfs:comment xml:lang="en">Anything spatial (being or having a shape, position or an extent)</rdfs:comment>
        <rdfs:comment xml:lang="es">Todo lo espacial (que tiene forma, posición o extensión).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
        <rdfs:label>Spatial Object</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/2004/02/skos/core#Concept -->


    <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#Concept">
        <rdfs:comment xml:lang="en">A SKOS concept can be viewed as an idea or notion; a unit of thought.</rdfs:comment>
        <rdfs:comment xml:lang="es">Un concepto SKOS puede verse como una idea o noción; una unidad de pensamiento.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2004/02/skos/core"/>
        <rdfs:label>Concept</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/2006/time#DateTimeDescription -->


    <owl:Class rdf:about="http://www.w3.org/2006/time#DateTimeDescription">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/time#GeneralDateTimeDescription"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2006/time#year"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#gYear"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Descripción de la fecha y la hora estructuradas con valores separados para los distintos elementos de un sistema de calendario-reloj. El sistema de referencia temporal está fijado al calendario gregoriano, y el rango de las propiedades de año, mes y día está restringido a los tipos de esquema XML correspondientes: xsd:gYear, xsd:gMonth y xsd:gDay, respectivamente.</rdfs:comment>
        <rdfs:comment xml:lang="en">Description of date and time structured with separate values for the various elements of a calendar-clock system. The temporal reference system is fixed to Gregorian Calendar, and the range of year, month, day properties restricted to corresponding XML Schema types xsd:gYear, xsd:gMonth and xsd:gDay, respectively.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2006/time"/>
        <rdfs:label>Date Time Description</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/2006/time#DateTimeInterval -->


    <owl:Class rdf:about="http://www.w3.org/2006/time#DateTimeInterval">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/time#ProperInterval"/>
        <rdfs:comment xml:lang="en">Defined using the multi-element date-time description. Can only be used for an interval whose boundaries match a date-time element aligned with the specified calendar and time zone.</rdfs:comment>
        <rdfs:comment xml:lang="es">Definida utilizando el multi-elemento descripción de fecha-hora. Se puede utilizar sólo para un intervalo cuyos límites coinciden con un elemento de fecha-hora alineados con el calendario y la zona horaria indicados.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2006/time#"/>
        <rdfs:label>Date Time Interval</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/2006/time#GeneralDateTimeDescription -->


    <owl:Class rdf:about="http://www.w3.org/2006/time#GeneralDateTimeDescription">
        <rdfs:comment xml:lang="es">Descripción de la fecha y la hora estructuradas con valores separados para los distintos elementos de un sistema de calendario-reloj.</rdfs:comment>
        <rdfs:comment xml:lang="en">Description of date and time structured with separate values for the various elements of a calendar-clock system</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2006/time"/>
        <rdfs:label>General Date Time Description</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/2006/time#Instant -->


    <owl:Class rdf:about="http://www.w3.org/2006/time#Instant">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
        <rdfs:comment xml:lang="en">A temporal entity with zero extent or duration.</rdfs:comment>
        <rdfs:comment xml:lang="es">Una entidad temporal con extensión o duración cero.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2006/time#"/>
        <rdfs:label>Instant</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/2006/time#Interval -->


    <owl:Class rdf:about="http://www.w3.org/2006/time#Interval">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
        <rdfs:comment xml:lang="en">A temporal entity with a limited extension or duration.</rdfs:comment>
        <rdfs:comment xml:lang="es">Una entidad temporal con una extensión o duración limitada.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2006/time#"/>
        <rdfs:label>Interval</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/2006/time#ProperInterval -->


    <owl:Class rdf:about="http://www.w3.org/2006/time#ProperInterval">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/time#Interval"/>
        <rdfs:comment xml:lang="en">A temporal entity with non-zero extent or duration, i.e. for which the value of the beginning and end are different</rdfs:comment>
        <rdfs:comment xml:lang="es">Una entidad temporal con extensión o duración distinta de cero, es decir, para la cual el valor del principio y del final son diferentes.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2006/time#"/>
        <rdfs:label>Proper Interval</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/2006/time#TemporalEntity -->


    <owl:Class rdf:about="http://www.w3.org/2006/time#TemporalEntity">
        <rdfs:comment xml:lang="en">A temporal interval or instant.</rdfs:comment>
        <rdfs:comment xml:lang="es">Un intervalo de tiempo o instante.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2006/time#"/>
        <rdfs:label>Temporal Entity</rdfs:label>
    </owl:Class>
    


    <!-- https://saref.etsi.org/core/UnitOfMeasure -->


    <owl:Class rdf:about="https://saref.etsi.org/core/UnitOfMeasure">
        <rdfs:comment xml:lang="es">La unidad de medida es un estándar para medir una cantidad, como por ejemplo una propiedad.</rdfs:comment>
        <rdfs:comment xml:lang="en">The unit of measure is a standard for measurement of a quantity, such as a Property.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://saref.etsi.org/core/"/>
        <rdfs:label>Unit Of Measure</rdfs:label>
    </owl:Class>
    


    <!-- https://saref.etsi.org/saref4city/AdministrativeArea -->


    <owl:Class rdf:about="https://saref.etsi.org/saref4city/AdministrativeArea">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:comment xml:lang="en">An administrative division, unit, entity, area or region, also referred to as a subnational entity, constituent unit, or country subdivision, is a portion of a country or other region delineated for the purpose of administration. (https://en.wikipedia.org/wiki/Administrative_division</rdfs:comment>
        <rdfs:comment xml:lang="es">Una división administrativa, unidad, entidad, área o región, también denominada entidad subnacional, unidad constituyente o subdivisión de país, es una porción de un país u otra región delimitada con fines administrativos. (https://en.wikipedia.org/wiki/Administrative_division</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://saref.etsi.org/saref4city/"/>
        <rdfs:label>Administrative Area</rdfs:label>
    </owl:Class>
    


    <!-- https://saref.etsi.org/saref4city/City -->


    <owl:Class rdf:about="https://saref.etsi.org/saref4city/City">
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4city/AdministrativeArea"/>
        <rdfs:comment xml:lang="en">A city is a large human settlement. A city is distinguished from other human settlements by its relatively great size, but also by its functions and its special symbolic status, which may be conferred by a central authority. (https://en.wikipedia.org/wiki/City)</rdfs:comment>
        <rdfs:comment xml:lang="es">Una ciudad es un gran asentamiento humano. Se distingue de otros asentamientos humanos por su tamaño relativamente grande, pero también por sus funciones y su estatus simbólico especial, que puede ser conferido por una autoridad central. (https://en.wikipedia.org/wiki/City)</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://saref.etsi.org/saref4city/"/>
        <rdfs:label>City</rdfs:label>
    </owl:Class>
    


    <!-- https://saref.etsi.org/saref4city/District -->


    <owl:Class rdf:about="https://saref.etsi.org/saref4city/District">
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4city/AdministrativeArea"/>
        <rdfs:comment xml:lang="en">A district is a type of administrative division that, in some countries, is managed by local government. Across the world, areas known as &quot;districts&quot; vary greatly in size, spanning regions or counties, several municipalities, subdivisions of municipalities, school district, or political district. (https://en.wikipedia.org/wiki/District)</rdfs:comment>
        <rdfs:comment xml:lang="es">Un distrito es un tipo de división administrativa que, en algunos países, es administrada por el gobierno local. En todo el mundo, las áreas conocidas como &quot;distritos&quot; varían mucho en tamaño, abarcando regiones o condados, varios municipios, subdivisiones de municipios, distritos escolares o distritos políticos. (https://en.wikipedia.org/wiki/District)</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://saref.etsi.org/saref4city/"/>
        <rdfs:label>District</rdfs:label>
    </owl:Class>
    


    <!-- https://saref.etsi.org/saref4city/KeyPerformanceIndicator -->


    <owl:Class rdf:about="https://saref.etsi.org/saref4city/KeyPerformanceIndicator">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A Key Performance Indicator (KPI) is a type of performance measurement. KPIs evaluate the success of an organization or of a particular activity in which it engages. (Definition taken from FIWARE)</rdfs:comment>
        <rdfs:comment xml:lang="es">Un Indicador Clave de Desempeño (KPI, por sus siglas en inglés) es un tipo de medición del desempeño. Los KPI evalúan el éxito de una organización o de una actividad específica en la que participa. (Definición tomada de FIWARE)</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://saref.etsi.org/saref4city/"/>
        <rdfs:label xml:lang="es">Indicador clave de rendimiento</rdfs:label>
        <rdfs:label xml:lang="en">Key Performance Indicator</rdfs:label>
    </owl:Class>
    


    <!-- https://saref.etsi.org/saref4city/KeyPerformanceIndicatorAssessment -->


    <owl:Class rdf:about="https://saref.etsi.org/saref4city/KeyPerformanceIndicatorAssessment">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/core/isMeasuredIn"/>
                <owl:allValuesFrom rdf:resource="https://saref.etsi.org/core/UnitOfMeasure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A Key Performance Indicator assessment represents the assessment of a KPI calculated by a given agent in a given time.</rdfs:comment>
        <rdfs:comment xml:lang="es">Una evaluación de Indicadores Clave de Rendimiento (del inglés sus siglas son KPI) representa la evaluación de un KPI calculado por un agente determinado en un tiempo determinado.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://saref.etsi.org/saref4city/"/>
        <rdfs:label>Key Performance Indicator Assessment</rdfs:label>
    </owl:Class>
    


