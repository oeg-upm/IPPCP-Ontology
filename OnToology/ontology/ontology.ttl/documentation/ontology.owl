        <rdfs:comment xml:lang="en">A unit of mass equal to 1,000 kilograms</rdfs:comment>
        <rdfs:comment xml:lang="es">Una unidad de masa equivalente a 1.000 kilogramos.</rdfs:comment>
        <rdfs:label xml:lang="es">Tonelada</rdfs:label>
        <rdfs:label xml:lang="en">Tonne</rdfs:label>
    </owl:NamedIndividual>
    


